[Unit]
Description=MariaDB FHEM history table backup
Requires=docker.service
After=docker.service

[Service]
EnvironmentFile=/home/pi/scripts/fhem-db-backup/.env
Type=oneshot
User=pi
Group=pi
ExecStart=/usr/bin/python3 /home/pi/scripts/fhem-db-backup/fhem-db-backup.py
WorkingDirectory=/home/pi/scripts/fhem-db-backup

[Install]
WantedBy=multi-user.target
