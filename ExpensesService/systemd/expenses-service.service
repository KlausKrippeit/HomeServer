[Unit]
Description=Webdienst für die persönliche Ausgabenverwaltung
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/scripts/ExpensesService
EnvironmentFile=/home/pi/scripts/ExpensesService/.env
ExecStart=/home/pi/scripts/ExpensesService/.venv/bin/python /home/pi/scripts/ExpensesService/web.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
