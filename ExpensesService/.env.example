# Nutzername:Kennwort; mehrere Einträge durch Kommas trennen.
USERS=Anna:change-me
# Durch einen langen, zufälligen Wert ersetzen.
SECRET_KEY=replace-with-a-long-random-secret
# Pfad zur SQLite-Datenbank.
DB_PATH=expenses.db
# Standardmäßig nur lokal erreichbar; nur in vertrauenswürdigen Netzen ändern.
BIND_HOST=127.0.0.1
BIND_PORT=8080
# SMTP-Zugangsdaten und Empfänger für Monatsberichte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Kategorien, kommasepariert; die letzte Kategorie ist die Ersatzkategorie.
CATEGORIES=Food,Transport,Home,Health,Other
